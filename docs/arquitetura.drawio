                <mxCell id="l4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" value="λ gerarRelatorioVendas" vertex="1">
                    <mxGeometry height="60" width="170" x="705" y="560" as="geometry"/>
