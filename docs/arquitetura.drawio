                <mxCell id="ddb" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="DynamoDB&lt;br&gt;&lt;b&gt;Pedidos&lt;/b&gt;&lt;br&gt;(pedidoId)" vertex="1">
                    <mxGeometry height="100" width="130" x="1050" y="220" as="geometry"/>
