                <!-- SNS + filas na altura do notificarEquipes -->
                <mxCell id="sns" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="SNS&lt;br&gt;&lt;b&gt;techcommerce-notificacoes&lt;/b&gt;" vertex="1">
