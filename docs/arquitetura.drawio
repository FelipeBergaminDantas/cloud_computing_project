                <mxCell id="e5" edge="1" parent="1" source="bus" target="l3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" value="regra-notificar-equipes">
