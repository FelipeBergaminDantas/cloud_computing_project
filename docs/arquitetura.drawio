                <mxCell id="e1" edge="1" parent="1" source="app" target="bus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="PedidoCriado">
