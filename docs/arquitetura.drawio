                <mxCell id="lambdas" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff8ee;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;fontColor=#9a6700;" value="AWS Lambda (Python 3.12)" vertex="1">
                    <mxGeometry height="585" width="240" x="670" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="l1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" value="λ validarPedido" vertex="1">
