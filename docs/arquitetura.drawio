                <mxCell id="e8" edge="1" parent="1" source="sns" target="q1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
                    <mxGeometry relative="1" as="geometry"/>
