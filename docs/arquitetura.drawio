<mxfile host="65bd71144e">
    <diagram id="techcommerce" name="TechCommerce Serverless">
        <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="820" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <!-- ===================== Titulo e area AWS ===================== -->
                <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=center;" value="TechCommerce – Arquitetura Serverless orientada a eventos (AWS Lambda + Amazon EventBridge)" vertex="1">
                    <mxGeometry height="30" width="1290" x="230" y="12" as="geometry"/>
                </mxCell>
                <mxCell id="aws" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#232F3E;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;" value="AWS (LocalStack) – us-east-1" vertex="1">
                    <mxGeometry height="745" width="1290" x="230" y="55" as="geometry"/>
                </mxCell>

                <!-- ===================== Aplicacao ===================== -->
                <mxCell id="app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" value="Aplicação&lt;br&gt;e-commerce&lt;br&gt;(checkout)" vertex="1">
                    <mxGeometry height="60" width="130" x="10" y="240" as="geometry"/>
                </mxCell>

                <!-- ===================== EventBridge ===================== -->
                <mxCell id="bus" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Amazon EventBridge&lt;br&gt;&lt;b&gt;techcommerce-bus&lt;/b&gt;" vertex="1">
                    <mxGeometry height="90" width="180" x="300" y="225" as="geometry"/>
                </mxCell>
                <mxCell id="sched" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="EventBridge – Regra agendada&lt;br&gt;(barramento default)&lt;br&gt;&lt;b&gt;rate(1 minute)&lt;/b&gt; (demo)&lt;br&gt;cron(0 9 * * ? *) (produção)" vertex="1">
                    <mxGeometry height="100" width="200" x="290" y="540" as="geometry"/>
                </mxCell>

