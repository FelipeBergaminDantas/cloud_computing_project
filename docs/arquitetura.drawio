                <mxCell id="iam" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="IAM Role&lt;br&gt;&lt;b&gt;techcommerce-lambda-role&lt;/b&gt;&lt;br&gt;permissões mínimas das 4 Lambdas" vertex="1">
